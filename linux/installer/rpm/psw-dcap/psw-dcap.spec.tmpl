%prep
%setup -qc

%build
%undefine _auto_set_build_flags
make %{?_smp_mflags} build

%install
make DESTDIR=%{?buildroot} install

for pkg in $(ls -A %{?buildroot} 2> /dev/null |grep -v "license"); do
    # Runtime libraries are owned by the sgx-enclave-runtime package now;
    # discard them here instead of packaging them.
    case " libsgx-headers libsgx-urts libsgx-enclave-common libsgx-enclave-common-devel " in
        *" ${pkg} "*) rm -fr %{?buildroot}/${pkg}; continue ;;
    esac
    install -d %{?buildroot}/${pkg}/%{_docdir}/${pkg}
    find %{?buildroot}/license -type f -print0 | \
    xargs -0 -n1 cat >> %{?buildroot}/${pkg}/%{_docdir}/${pkg}/%{_license_file}
    find %{?buildroot}/${pkg} -type d -exec \
    sh -c '(ls -p "{}"|grep />/dev/null)||echo "{}"' \; | \
    sed -e "s#^%{?buildroot}/${pkg}##" | \
    grep -v "^%{_libdir}" | \
    grep -v "^%{_includedir}" | \
    grep -v "^%{_sysconfdir}" | \
    grep -v "^%{_bindir}" | \
    grep -v "^%{_aesm_service_path}" | \
    grep -v "^%{_dcap_pccs_path}" | \
    grep -v "^%{_ra_service_path}" | \
    grep -v "^%{_pck_id_retrieval_tool_path}" | \
    grep -v "^%{_pcs_client_path}" | \
    grep -v "^%{_pccs_admin_path}" | \
    grep -v "^%{_poe_gen_path}" | \
    sed -e "s#^#%dir #" > %{_specdir}/list-${pkg}
    for f in $(find %{?buildroot}/${pkg}); do
        if [ -d ${f} ]; then
            echo ${f} | sed -e "s#^%{?buildroot}/${pkg}##" | \
            grep -E "^%{_aesm_service_path}|^%{_dcap_pccs_path}|^%{_ra_service_path}|^%{_pck_id_retrieval_tool_path}|^%{_pcs_client_path}|^%{_pccs_admin_path}|^%{_poe_gen_path}" | \
            sed -e "s#^#%dir #" >> %{_specdir}/list-${pkg}
        else
            echo ${f} | \
            sed -e "s#^%{?buildroot}/${pkg}##" >> %{_specdir}/list-${pkg}
        fi
    done
    cp -r %{?buildroot}/${pkg}/* %{?buildroot}/
    rm -fr %{?buildroot}/${pkg}
    sed -i -e 's:^/etc/.*\.conf:%config &:' \
           -e 's:^%{_dcap_pccs_path}/config/default\.json:%config &:' %{_specdir}/list-${pkg}
done
rm -fr %{?buildroot}/license

echo "%%ghost %{_pcs_client_path}/%{_pcs_client_wrapper}" >> %{_specdir}/list-intel-tee-pcs-client-tool
echo "%%ghost %{_bindir}/%{_pcs_client_wrapper}"          >> %{_specdir}/list-intel-tee-pcs-client-tool
echo "%%ghost %{_pccs_admin_path}/%{_pccs_admin_wrapper}" >> %{_specdir}/list-intel-tee-pccs-admin-tool
echo "%%ghost %{_bindir}/%{_pccs_admin_wrapper}"          >> %{_specdir}/list-intel-tee-pccs-admin-tool
echo "%%ghost %{_bindir}/%{_poe_gen_tool_name}"           >> %{_specdir}/list-intel-tee-poe-gen-tool

%clean
make clean

%files -f %{_specdir}/list-%{name}
%files -n libsgx-ae-pce -f %{_specdir}/list-libsgx-ae-pce
%files -n libsgx-aesm-ecdsa-plugin -f %{_specdir}/list-libsgx-aesm-ecdsa-plugin
%files -n libsgx-aesm-pce-plugin -f %{_specdir}/list-libsgx-aesm-pce-plugin
%files -n libsgx-aesm-quote-ex-plugin -f %{_specdir}/list-libsgx-aesm-quote-ex-plugin
%files -n libsgx-quote-ex -f %{_specdir}/list-libsgx-quote-ex
%files -n libsgx-quote-ex-devel -f %{_specdir}/list-libsgx-quote-ex-devel
%files -n libsgx-uae-service -f %{_specdir}/list-libsgx-uae-service
