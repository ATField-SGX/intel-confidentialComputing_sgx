%post -n libsgx-ae-pce
trigger_udev() {
    if ! which udevadm &> /dev/null; then
        return 0
    fi
    udevadm control --reload || :
    udevadm trigger || :
}

# Add sgx_prv for in-kernel driver.
if [ -c /dev/sgx_provision -o -c /dev/sgx/provision ]; then
    getent group sgx_prv &> /dev/null || groupadd sgx_prv
    trigger_udev
fi

%post -n intel-tee-pcs-client-tool -p /bin/bash
set -Eeuo pipefail

on_pip_error() {
    error_code=$?
    if [[ "${pip_output:-}" == *Network* ]] || [[ "${pip_output:-}" == *ProxyError* ]] || [[ "${pip_output:-}" == *NewConnectionError* ]] || [[ "${pip_output:-}" == *SSLError* ]]; then
        echo -e "ERROR: 'pip install' failed with exit code ${error_code}. See the %post output above for details.\n" >&2
        echo "Note: if this is network-related and you are behind a proxy, set the proxy env vars and retry, e.g.:" >&2
        echo "      #> https_proxy=http://proxy.example.com:1234 dnf install intel-tee-pcs-client-tool" >&2
        echo "      See: https://pip.pypa.io/en/stable/user_guide/#using-a-proxy-server" >&2
        echo "      Detected: http_proxy=[${http_proxy:-not set}] https_proxy=[${https_proxy:-not set}] no_proxy=[${no_proxy:-not set}]" >&2
    fi
    exit ${error_code}
}

if [ -d "%{_pcs_client_venv_dir}" ]; then rm -rf "%{_pcs_client_venv_dir}"; fi
python3 -m venv "%{_pcs_client_venv_dir}"
source "%{_pcs_client_venv_dir}/bin/activate"
OUT_STREAM=$( [ -t 1 ] && [ -e /dev/tty ] && [ -w /dev/tty ] && echo /dev/tty || echo /dev/stderr )
trap 'on_pip_error' ERR
export PIP_DEFAULT_TIMEOUT=${PIP_DEFAULT_TIMEOUT:-5}
export PIP_RETRIES=${PIP_RETRIES:-1}
pip_output=$(python3 -m pip install --no-input --require-virtualenv --upgrade pip 2>&1 | tee ${OUT_STREAM})
pip_output=$(python3 -m pip install --no-input --require-virtualenv --upgrade setuptools wheel 2>&1 | tee ${OUT_STREAM})
pip_output=$(python3 -m pip install --no-input --require-virtualenv -r "%{_pcs_client_path}/requirements.txt" 2>&1 | tee ${OUT_STREAM})
trap - ERR

%posttrans -n intel-tee-pcs-client-tool
cat <<EOF > "%{_pcs_client_path}/%{_pcs_client_wrapper}"
#!/usr/bin/env bash
source "%{_pcs_client_venv_dir}/bin/activate"
exec PCS_CLIENT_TOOL_EXECUTABLE_WRAPPER=%{_pcs_client_wrapper} PYTHONPYCACHEPREFIX="%{_pcs_client_venv_dir}/__pycache__" python3 "%{_pcs_client_path}/%{_pcs_client_main_script}" "\$@"
EOF
chmod +x "%{_pcs_client_path}/%{_pcs_client_wrapper}"
if [ -e "%{_bindir}/%{_pcs_client_wrapper}" ] && [ ! -L "%{_bindir}/%{_pcs_client_wrapper}" ]; then
    echo "ERROR: %{_bindir}/%{_pcs_client_wrapper} exists and is not a symlink; refusing to overwrite." >&2
    exit 1
fi
ln -sf "%{_pcs_client_path}/%{_pcs_client_wrapper}" %{_bindir}/%{_pcs_client_wrapper}

%preun -n intel-tee-pcs-client-tool
if [ -d "%{_pcs_client_path}" ]; then
    find "%{_pcs_client_path}" -type d -name "__pycache__" -exec rm -rf {} +
fi
if [ $1 -ne 0 ]; then exit 0; fi
rm -rf "%{_pcs_client_venv_dir}"
rm -f "%{_pcs_client_path}/%{_pcs_client_wrapper}"
rm -f "%{_bindir}/%{_pcs_client_wrapper}"

%post -n intel-tee-pccs-admin-tool -p /bin/bash
set -Eeuo pipefail

on_pip_error() {
    error_code=$?
    if [[ "${pip_output:-}" == *Network* ]] || [[ "${pip_output:-}" == *ProxyError* ]] || [[ "${pip_output:-}" == *NewConnectionError* ]] || [[ "${pip_output:-}" == *SSLError* ]]; then
        echo -e "ERROR: 'pip install' failed with exit code ${error_code}. See the %post output above for details.\n" >&2
        echo "Note: if this is network-related and you are behind a proxy, set the proxy env vars and retry, e.g.:" >&2
        echo "      #> https_proxy=http://proxy.example.com:1234 dnf install intel-tee-pccs-admin-tool" >&2
        echo "      See: https://pip.pypa.io/en/stable/user_guide/#using-a-proxy-server" >&2
        echo "      Detected: http_proxy=[${http_proxy:-not set}] https_proxy=[${https_proxy:-not set}] no_proxy=[${no_proxy:-not set}]" >&2
    fi
    exit ${error_code}
}

if [ -d "%{_pccs_admin_venv_dir}" ]; then rm -rf "%{_pccs_admin_venv_dir}"; fi
python3 -m venv "%{_pccs_admin_venv_dir}"
source "%{_pccs_admin_venv_dir}/bin/activate"
OUT_STREAM=$( [ -t 1 ] && [ -e /dev/tty ] && [ -w /dev/tty ] && echo /dev/tty || echo /dev/stderr )
trap 'on_pip_error' ERR
export PIP_DEFAULT_TIMEOUT=${PIP_DEFAULT_TIMEOUT:-5}
export PIP_RETRIES=${PIP_RETRIES:-1}
pip_output=$(python3 -m pip install --no-input --require-virtualenv --upgrade pip 2>&1 | tee ${OUT_STREAM})
pip_output=$(python3 -m pip install --no-input --require-virtualenv --upgrade setuptools wheel 2>&1 | tee ${OUT_STREAM})
pip_output=$(python3 -m pip install --no-input --require-virtualenv -r "%{_pccs_admin_path}/requirements.txt" 2>&1 | tee ${OUT_STREAM})
trap - ERR

%posttrans -n intel-tee-pccs-admin-tool
cat <<EOF > "%{_pccs_admin_path}/%{_pccs_admin_wrapper}"
#!/usr/bin/env bash
source "%{_pccs_admin_venv_dir}/bin/activate"
PCCS_ADMIN_TOOL_EXECUTABLE_WRAPPER=%{_pccs_admin_wrapper} PYTHONPYCACHEPREFIX="%{_pccs_admin_venv_dir}/__pycache__" python3 "%{_pccs_admin_path}/%{_pccs_admin_main_script}" "\$@"
EOF
chmod +x "%{_pccs_admin_path}/%{_pccs_admin_wrapper}"
# Guard against clobbering a real file owned by another package: replace our own
# symlink (idempotent for upgrades/reinstalls) but fail clearly on a regular file.
if [ -e "%{_bindir}/%{_pccs_admin_wrapper}" ] && [ ! -L "%{_bindir}/%{_pccs_admin_wrapper}" ]; then
    echo "ERROR: %{_bindir}/%{_pccs_admin_wrapper} exists and is not a symlink; refusing to overwrite." >&2
    exit 1
fi
ln -sf "%{_pccs_admin_path}/%{_pccs_admin_wrapper}" %{_bindir}/%{_pccs_admin_wrapper}

%preun -n intel-tee-pccs-admin-tool
if [ -d "%{_pccs_admin_path}" ]; then
    find "%{_pccs_admin_path}" -type d -name "__pycache__" -exec rm -rf {} +
fi
if [ $1 -ne 0 ]; then exit 0; fi
rm -rf "%{_pccs_admin_venv_dir}"
rm -f "%{_pccs_admin_path}/%{_pccs_admin_wrapper}"
rm -f "%{_bindir}/%{_pccs_admin_wrapper}"

%posttrans -n intel-tee-poe-gen-tool
if [ ! -f %{_poe_gen_path}/%{_poe_gen_tool_name} ]; then
    echo "ERROR: %{_poe_gen_path}/%{_poe_gen_tool_name} not found." >&2
    exit 6
fi
if [ -e "%{_bindir}/%{_poe_gen_tool_name}" ] && [ ! -L "%{_bindir}/%{_poe_gen_tool_name}" ]; then
    echo "ERROR: %{_bindir}/%{_poe_gen_tool_name} exists and is not a symlink; refusing to overwrite." >&2
    exit 1
fi
ln -s -f %{_poe_gen_path}/%{_poe_gen_tool_name} %{_bindir}/%{_poe_gen_tool_name}

%postun -n intel-tee-poe-gen-tool
if [ "$1" -eq 0 ]; then
    rm -f %{_bindir}/%{_poe_gen_tool_name}
fi

%changelog
* Mon Jun 7 2021 SGX Team
- Initial Release
